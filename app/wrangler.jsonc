{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aiverse",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-21",
  "assets": {
    // Serve index.html for app routes like /tone; the Vue router takes it from there.
    "not_found_handling": "single-page-application",
    // Only API requests run the Worker. Everything else is a static asset.
    "run_worker_first": ["/api/*"],
  },
  // Settings applied on every deploy. OPENAI_TOKEN is a secret: set it with
  // `wrangler secret put` (or in the dashboard), and in .dev.vars for local dev.
  // AUTH_TOKEN lives here, so don't also add it as a dashboard secret — the
  // names would clash. Values in .dev.vars override these locally.
  "vars": {
    "AUTH_TOKEN": "Zw0SZ2ZP2MMr66MEhL",
    // The OpenAI model and reasoning effort behind each option in the app's
    // Settings. The app shows these as "Most capable" (£££), "Balanced" (££) and
    // "Quickest" (£), and never names the model.
    "MODEL_TIERS": {
      "capable": { "model": "gpt-5.6-sol", "reasoning_effort": "medium" },
      "balanced": { "model": "gpt-5.6-terra", "reasoning_effort": "low" },
      "quick": { "model": "gpt-5.6-luna", "reasoning_effort": "low" },
    },
    // Used when a request doesn't choose a tier (the app always does).
    "DEFAULT_TIER": "balanced",
    "TIMEOUT": "60",
  },
  "observability": {
    "enabled": true,
  },
}
