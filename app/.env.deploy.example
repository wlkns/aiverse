# Copy to .env.deploy (git-ignored) for `pnpm deploy:bunny`.

# Storage zone → name, and FTP & API Access → password + hostname
BUNNY_STORAGE_ZONE=aiverse
BUNNY_STORAGE_PASSWORD=
BUNNY_STORAGE_HOST=storage.bunnycdn.com

# Account settings → API key, and the Pull Zone's numeric ID (in its dashboard URL)
BUNNY_API_KEY=
BUNNY_PULL_ZONE_ID=
