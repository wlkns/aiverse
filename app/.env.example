# Dev only: the Pull Zone URL that serves the API. `pnpm dev` proxies /api to it.
API_PROXY_TARGET=https://your-zone.b-cdn.net

# Optional: only set if the API lives on a different origin from the app
# (the API then needs ALLOWED_ORIGINS set). Defaults to same-origin /api.
# VITE_API_URL=https://api.example.com/api
